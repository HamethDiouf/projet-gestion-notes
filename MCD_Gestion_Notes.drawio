<mxfile host="app.diagrams.net">
  <diagram name="MCD Gestion Notes">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Entité Étudiant -->
        <mxCell id="etudiant" value="Étudiant&#10;id_étudiant&#10;Nom&#10;Prénom&#10;Date_naissance&#10;Email" style="shape=rectangle;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Entité Classe -->
        <mxCell id="classe" value="Classe&#10;id_classe&#10;Libellé" style="shape=rectangle;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- Entité Filière -->
        <mxCell id="filiere" value="Filière&#10;id_filière&#10;Libellé" style="shape=rectangle;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- Entité Matière -->
        <mxCell id="matiere" value="Matière&#10;id_matière&#10;Libellé&#10;Coefficient" style="shape=rectangle;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- Entité Enseignant -->
        <mxCell id="enseignant" value="Enseignant&#10;id_enseignant&#10;Nom&#10;Prénom&#10;Email" style="shape=rectangle;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="280" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- Entité Note -->
        <mxCell id="note" value="Note&#10;id_note&#10;Valeur&#10;Date_evaluation&#10;id_étudiant&#10;id_matière&#10;id_enseignant" style="shape=rectangle;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="200" height="120" as="geometry"/>
        </mxCell>

        <!-- Relations -->
        <mxCell id="rel_etudiant_classe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="etudiant" target="classe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel_classe_filiere" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="classe" target="filiere">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel_matiere_enseignant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="matiere" target="enseignant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel_note_etudiant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="note" target="etudiant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel_note_matiere" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="note" target="matiere">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rel_note_enseignant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;" edge="1" parent="1" source="note" target="enseignant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
SELECT datname FROM pg_database;